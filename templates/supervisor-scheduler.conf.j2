[program:emms-scheduler]
process_name=%(program_name)s_%(process_num)02d
directory={{ project_root }}
command=php {{ project_root }}/artisan schedule:work
autostart=true
autorestart=true
stopasgroup=true
killasgroup=true
user={{ app_user }}
numprocs=1
redirect_stderr=true
stdout_logfile={{ project_root }}/storage/logs/scheduler.log
stopwaitsecs=60
